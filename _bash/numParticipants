numMentors=$(ls -l ../_mentors | wc -l)
numMentees=$(ls -l ../_mentees | wc -l)
if (( $# == 0 )) ; then
	totalParticipants=$(( "$numMentors" + "$numMentees" ))
	echo "$totalParticipants"
elif (( $# == 1 )) ; then
	if [[ ${1} == 'mentors' ]] ; then
		echo "$numMentors"
	elif [[ ${1} == 'mentees' ]] ; then
		echo "$numMentees"
	else
		echo 'Argument was not recognized. Type "mentors" or "mentees".'
	fi
else
	echo 'Incorrect number of arguments. Pass no argument, "mentors" or "mentees".'
fi
